{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scnsim:schema:identity-v3",
  "title": "SCNSim evidence-v3 storage documents",
  "description": "Evidence binary framing/header and manifest/ref authority. OperationStore revision8 is distinct. Plan/Request/ParameterSet/authoring snapshot schema numbers and bytes remain unchanged in identity-v2. Workspace schema1 has required evidence_version3 in identity-common.",
  "oneOf": [
    {
      "$ref": "#/$defs/numericBlockHeader"
    },
    {
      "$ref": "#/$defs/objectReference"
    },
    {
      "$ref": "#/$defs/chunkManifest"
    },
    {
      "$ref": "#/$defs/sweepManifest"
    },
    {
      "$ref": "#/$defs/sensitivityManifest"
    },
    {
      "$ref": "#/$defs/optimizationManifest"
    },
    {
      "$ref": "#/$defs/directChunkSummary"
    }
  ],
  "$defs": {
    "numericBlockHeader": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "record",
        "columns",
        "context",
        "chunk_ordinal"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.numeric_block"
        },
        "schema_version": {
          "const": 3
        },
        "record": {},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "context": {
          "type": "object"
        },
        "chunk_ordinal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": [
        "ordinal",
        "path",
        "dtype",
        "byte_order",
        "shape",
        "order",
        "axes",
        "unit",
        "complex_representation",
        "offset",
        "byte_length",
        "representation"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "dtype": {
          "enum": [
            "bool",
            "int8",
            "uint8",
            "int16",
            "uint16",
            "int32",
            "uint32",
            "int64",
            "uint64",
            "float32",
            "float64",
            "complex64",
            "complex128"
          ]
        },
        "byte_order": {
          "const": "little"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "order": {
          "const": "C"
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "complex_representation": {
          "enum": [
            "interleaved_real_imag",
            "not_complex"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "representation": {
          "enum": [
            "array_record",
            "scalar_sequence"
          ]
        }
      },
      "additionalProperties": false
    },
    "objectReference": {
      "type": "object",
      "required": [
        "schema_version",
        "storage",
        "database",
        "role",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "schema_version": {
          "const": 8
        },
        "storage": {
          "const": "sqlite"
        },
        "database": {
          "const": "operations.sqlite3"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "chunkManifest": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "evidence_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "request_ref",
        "metadata"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.direct_manifest"
        },
        "schema_version": {
          "const": 1
        },
        "evidence_version": {
          "const": 3
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "request_ref": {
          "$ref": "#/$defs/objectReference"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "sweepManifest": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "evidence_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "request_ref",
        "metadata"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.sweep_manifest"
        },
        "schema_version": {
          "const": 1
        },
        "evidence_version": {
          "const": 3
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "request_ref": {
          "$ref": "#/$defs/objectReference"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "sensitivityManifest": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "evidence_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "request_ref",
        "program_sha256",
        "quantity_layout",
        "derivative_layout"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.sensitivity_manifest"
        },
        "schema_version": {
          "const": 1
        },
        "evidence_version": {
          "const": 3
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "request_ref": {
          "$ref": "#/$defs/objectReference"
        },
        "program_sha256": {
          "type": "string"
        },
        "quantity_layout": {},
        "derivative_layout": {}
      },
      "additionalProperties": false
    },
    "optimizationManifest": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "evidence_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "request_ref",
        "declarations",
        "stage_ids"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.optimization_manifest"
        },
        "schema_version": {
          "const": 1
        },
        "evidence_version": {
          "const": 3
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "request_ref": {
          "$ref": "#/$defs/objectReference"
        },
        "declarations": {
          "type": "object"
        },
        "stage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "directChunkSummary": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "ordinal",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.direct_chunk_summary"
        },
        "schema_version": {
          "const": 1
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
