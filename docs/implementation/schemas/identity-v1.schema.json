{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scnsim:schema:identity-v1",
  "title": "SCNSim V1 identity documents",
  "description": "Canonical envelope schemas for the CONVERGING SCNSim V1 workspace protocol.",
  "oneOf": [
    { "$ref": "#/$defs/workspace" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/attempt" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "workspaceInstanceId": {
      "description": "Evidence-only UUID for one concrete workspace binding.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "f64": {
      "description": "Finite IEEE-754 binary64 encoded as 16 lowercase big-endian hexadecimal digits.",
      "type": "string",
      "pattern": "^(?!(?:7ff|fff))[0-9a-f]{16}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "si_value_f64", "si_unit", "dimensionality"],
      "properties": {
        "type": { "const": "quantity_f64" },
        "si_value_f64": { "$ref": "#/$defs/f64" },
        "si_unit": { "type": "string", "minLength": 1 },
        "dimensionality": { "type": "string", "minLength": 1 }
      }
    },
    "complexQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "real_si_f64", "imag_si_f64", "si_unit", "dimensionality"],
      "properties": {
        "type": { "const": "complex_quantity_f64" },
        "real_si_f64": { "$ref": "#/$defs/f64" },
        "imag_si_f64": { "$ref": "#/$defs/f64" },
        "si_unit": { "type": "string", "minLength": 1 },
        "dimensionality": { "type": "string", "minLength": 1 }
      }
    },
    "typedValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "string" },
        { "$ref": "#/$defs/quantity" },
        { "$ref": "#/$defs/complexQuantity" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "bits"],
          "properties": {
            "type": { "const": "f64" },
            "bits": { "$ref": "#/$defs/f64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "list" },
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/typedValue" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "entries"],
          "properties": {
            "type": { "const": "map" },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "value"],
                "properties": {
                  "key": { "type": "string" },
                  "value": { "$ref": "#/$defs/typedValue" }
                }
              }
            }
          }
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "pin_id"],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "pin_id": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "media_type",
        "dtype",
        "shape",
        "axes",
        "unit"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "type": "string", "minLength": 1 },
        "dtype": { "enum": ["float64", "complex128"] },
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "axes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "python_source_sha256",
        "julia_source_sha256",
        "julia_version",
        "project_sha256",
        "manifest_sha256"
      ],
      "properties": {
        "algorithm_id": { "type": "string", "minLength": 1 },
        "python_source_sha256": { "$ref": "#/$defs/sha256" },
        "julia_source_sha256": { "$ref": "#/$defs/sha256" },
        "julia_version": { "type": "string", "minLength": 1 },
        "project_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalogSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "module",
        "qualified_class",
        "source_kind",
        "source_sha256"
      ],
      "properties": {
        "catalog_id": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "qualified_class": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["wheel_record", "editable_git", "notebook_source"] },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "distribution": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "git_commit": { "$ref": "#/$defs/gitObjectId" },
        "dirty_overlay_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source_kind": { "const": "wheel_record" } },
            "required": ["source_kind"]
          },
          "then": {
            "required": ["distribution", "version"],
            "not": {
              "anyOf": [
                { "required": ["git_commit"] },
                { "required": ["dirty_overlay_sha256"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "source_kind": { "const": "editable_git" } },
            "required": ["source_kind"]
          },
          "then": {
            "required": ["git_commit", "dirty_overlay_sha256"],
            "not": {
              "anyOf": [
                { "required": ["distribution"] },
                { "required": ["version"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "source_kind": { "const": "notebook_source" } },
            "required": ["source_kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["distribution"] },
                { "required": ["version"] },
                { "required": ["git_commit"] },
                { "required": ["dirty_overlay_sha256"] }
              ]
            }
          }
        }
      ]
    },
    "planWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "kind",
        "workspace_instance_id",
        "plan_sha256"
      ],
      "properties": {
        "schema": { "const": "scnsim.workspace" },
        "schema_version": { "const": 1 },
        "kind": { "const": "plan_workspace" },
        "workspace_instance_id": { "$ref": "#/$defs/workspaceInstanceId" },
        "plan_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versionedWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "kind",
        "workspace_instance_id",
        "next_iteration",
        "iterations"
      ],
      "properties": {
        "schema": { "const": "scnsim.workspace" },
        "schema_version": { "const": 1 },
        "kind": { "const": "versioned_workspace" },
        "workspace_instance_id": { "$ref": "#/$defs/workspaceInstanceId" },
        "next_iteration": { "type": "integer", "minimum": 1 },
        "iterations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "directory", "plan_sha256"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 1 },
              "directory": { "type": "string", "pattern": "^iteration[0-9]{2,}$" },
              "plan_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "workspace": {
      "oneOf": [
        { "$ref": "#/$defs/planWorkspace" },
        { "$ref": "#/$defs/versionedWorkspace" }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "plan_id",
        "ground_id",
        "catalog_sources",
        "components",
        "nodes",
        "grounded_endpoints",
        "ports",
        "couplings"
      ],
      "properties": {
        "schema": { "const": "scnsim.plan" },
        "schema_version": { "const": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "ground_id": { "const": "ground" },
        "catalog_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogSource" }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component_id", "catalog_id", "factory", "parameters", "pin_order"],
            "properties": {
              "component_id": { "type": "string", "minLength": 1 },
              "catalog_id": { "type": "string", "minLength": 1 },
              "factory": { "enum": ["resistor", "capacitor", "inductor"] },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "baseline"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "baseline": { "$ref": "#/$defs/quantity" }
                  }
                }
              },
              "pin_order": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "visibility", "endpoints"],
            "properties": {
              "node_id": { "type": "string", "minLength": 1 },
              "visibility": { "enum": ["public", "internal", "port_promoted"] },
              "endpoints": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/endpoint" }
              }
            }
          }
        },
        "grounded_endpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["port_id", "node_id", "role", "reference_impedance"],
            "properties": {
              "port_id": { "type": "string", "minLength": 1 },
              "node_id": { "type": "string", "minLength": 1 },
              "role": { "enum": ["terminated", "nonloading_probe"] },
              "reference_impedance": { "$ref": "#/$defs/quantity" }
            }
          }
        },
        "couplings": {
          "description": "Empty in the Primitive Direct E2E schema; later slices require a schema-version extension.",
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "plan_sha256",
        "operation",
        "ref_lineage",
        "spec",
        "parameters",
        "runtime_semantic"
      ],
      "properties": {
        "schema": { "const": "scnsim.request" },
        "schema_version": { "const": 1 },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "operation": { "enum": ["solve_direct", "evaluate_diagonal_root"] },
        "ref_lineage": { "$ref": "#/$defs/refLineage" },
        "spec": {
          "oneOf": [
            { "$ref": "#/$defs/directSolveSpec" },
            { "$ref": "#/$defs/diagonalRootSpec" }
          ]
        },
        "parameters": { "$ref": "#/$defs/parameterSet" },
        "runtime_semantic": { "$ref": "#/$defs/runtimeSemantic" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "solve_direct" } },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "ref_lineage": { "$ref": "#/$defs/originalRef" },
              "spec": { "$ref": "#/$defs/directSolveSpec" }
            }
          },
          "else": {
            "properties": {
              "ref_lineage": { "$ref": "#/$defs/retainedRef" },
              "spec": { "$ref": "#/$defs/diagonalRootSpec" }
            }
          }
        }
      ]
    },
    "originalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "original" } }
    },
    "retainedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "retain" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "refLineage": {
      "oneOf": [
        { "$ref": "#/$defs/originalRef" },
        { "$ref": "#/$defs/retainedRef" }
      ]
    },
    "directSolveSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "frequencies"],
      "properties": {
        "type": { "const": "direct_solve" },
        "frequencies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/quantity" }
        }
      }
    },
    "diagonalRootSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinate", "root_hint"],
      "properties": {
        "type": { "const": "diagonal_root" },
        "coordinate": { "type": "string", "minLength": 1 },
        "root_hint": { "$ref": "#/$defs/quantity" }
      }
    },
    "parameterSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bindings"],
      "properties": {
        "type": { "const": "parameter_set" },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parameter_id", "value"],
            "properties": {
              "parameter_id": { "type": "string", "minLength": 1 },
              "value": { "$ref": "#/$defs/quantity" }
            }
          }
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "request_sha256",
        "ordinal",
        "attempt_state",
        "started_at_utc",
        "julia_executable_sha256",
        "os",
        "architecture",
        "cpu",
        "julia_threads",
        "blas_threads",
        "blas_vendor"
      ],
      "properties": {
        "schema": { "const": "scnsim.attempt" },
        "schema_version": { "const": 1 },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "attempt_state": { "const": "launched" },
        "started_at_utc": { "type": "string", "format": "date-time" },
        "julia_executable_sha256": { "$ref": "#/$defs/sha256" },
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "julia_threads": { "type": "integer", "minimum": 1 },
        "blas_threads": { "type": "integer", "minimum": 1 },
        "blas_vendor": { "type": "string", "minLength": 1 }
      }
    },
    "directResponseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "result_kind",
        "scalar_catalog",
        "array_catalog"
      ],
      "properties": {
        "schema": { "const": "scnsim.result" },
        "schema_version": { "const": 1 },
        "result_kind": { "const": "direct_response" },
        "scalar_catalog": {
          "type": "object",
          "maxProperties": 0
        },
        "array_catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frequencies", "s", "y", "z"],
          "properties": {
            "frequencies": { "$ref": "#/$defs/artifact" },
            "s": { "$ref": "#/$defs/artifact" },
            "y": { "$ref": "#/$defs/artifact" },
            "z": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    },
    "directQuantityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "result_kind",
        "scalar_catalog",
        "array_catalog"
      ],
      "properties": {
        "schema": { "const": "scnsim.result" },
        "schema_version": { "const": 1 },
        "result_kind": { "const": "direct_quantity" },
        "scalar_catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "frequency", "linewidth", "slope"],
          "properties": {
            "root": { "$ref": "#/$defs/complexQuantity" },
            "frequency": { "$ref": "#/$defs/quantity" },
            "linewidth": { "$ref": "#/$defs/quantity" },
            "slope": { "$ref": "#/$defs/complexQuantity" }
          }
        },
        "array_catalog": {
          "type": "object",
          "maxProperties": 0
        }
      }
    },
    "result": {
      "oneOf": [
        { "$ref": "#/$defs/directResponseResult" },
        { "$ref": "#/$defs/directQuantityResult" }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "evidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/typedValue" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "request_sha256",
        "attempt_sha256",
        "outcome",
        "artifact_sha256",
        "evidence"
      ],
      "properties": {
        "schema": { "const": "scnsim.receipt" },
        "schema_version": { "const": 1 },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "attempt_sha256": { "$ref": "#/$defs/sha256" },
        "outcome": { "enum": ["success", "failure", "interrupted"] },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        },
        "evidence": { "$ref": "#/$defs/typedValue" },
        "failure": { "$ref": "#/$defs/failure" },
        "sealed_at_utc": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "success" } },
            "required": ["outcome"]
          },
          "then": {
            "required": ["result_sha256"],
            "not": { "required": ["failure"] }
          },
          "else": {
            "required": ["failure"],
            "not": { "required": ["result_sha256"] }
          }
        }
      ]
    }
  }
}
